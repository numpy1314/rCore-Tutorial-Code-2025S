# Keep shared code-agent configuration tracked.
!.codex/config.toml
!.codex/langfuse.example.json
!.claude/settings.json
!.claude/settings.local.example.json
!.cursor/hooks.example.json
!.cursor/langfuse.example.json
!.vscode/langfuse.example.json
!.vscode/copilot-hooks.example.json

# Per-student, project-local Langfuse credentials and per-agent archive modes.
.codex/langfuse.json
.claude/settings.local.json
.cursor/langfuse.json
.cursor/hooks.json
.cursor/rcore-hooks/
.vscode/langfuse.json
.vscode/settings.json
.vscode/rcore-hooks/
rcore-agent-token*.json

# Ignore the retired policy until setup migrates and removes it.
.agents/session-archive.json

# Local Markdown archives and legacy transcripts. These may contain sensitive data.
.agent-sessions/

# Python bytecode generated by the archive-plugin tests.
__pycache__/
*.py[cod]

# Local recording runtime and client configuration.
/.ai/course-tools/
/.ai/ide/
/.opencode/session-archive.json
/.opencode/rcore-hooks/
/.opencode/plugins/rcore-session-archive.js
!/.opencode/
/.opencode/*
!/.opencode/session-archive.example.json

# >>> course-tool records
!/.ai/
!/.ai/.gitignore
!/.ai/agent-sessions/
!/.ai/agent-sessions/**
!/.ai/events/
!/.ai/events/**
!/.ai/submissions/
!/.ai/submissions/**
# <<< course-tool records
